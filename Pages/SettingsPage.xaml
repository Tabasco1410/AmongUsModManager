<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AmongUsModManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AmongUsModManager.Models"
    xmlns:local="using:AmongUsModManager.Pages"
    mc:Ignorable="d">

    <Page.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="CustomListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="UnsavedChangesBar"
                 Grid.Row="0"
                 IsOpen="False"
                 Severity="Warning">
            <InfoBar.ActionButton>
                <Button x:Name="SaveAndExitButton" Click="SaveAndExit_Click" Style="{StaticResource AccentButtonStyle}"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock x:Name="SettingsPageTitle"
                   Grid.Row="1"
                   FontSize="28" FontWeight="SemiBold"
                   Margin="24,20,24,0"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ListView x:Name="TabNavList"
                          SelectionChanged="TabNav_SelectionChanged"
                          SelectedIndex="0"
                          Padding="8,8,8,8"
                          SelectionMode="Single">
                    <ListViewItem x:Name="TabAppearanceItem" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TabAppearanceLabel" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="TabGameItem" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TabGameLabel" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="TabSystemItem" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE823;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TabSystemLabel" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="TabNotifItem" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7E7;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TabNotifLabel" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <Grid Grid.Column="1">

                <!-- ══════════════════════════════════════════
                     外観タブ (index 0)
                     ══════════════════════════════════════════ -->
                <ScrollViewer x:Name="AppearanceContent"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Padding="24,12,24,32">
                    <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AppearanceSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="ThemeLabel" FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Spacing="6">
                                    <RadioButton x:Name="ThemeDefaultRadio" GroupName="Theme" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeDarkRadio"    GroupName="Theme" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeLightRadio"   GroupName="Theme" Checked="Theme_Checked"/>
                                </StackPanel>

                                <TextBlock x:Name="LanguageSectionLabel" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ComboBox x:Name="LanguageComboBox" MinWidth="220"
                                          SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                <InfoBar x:Name="LangPendingBar"
                                         IsOpen="False"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════
                     ゲームタブ (index 1)
                     ══════════════════════════════════════════ -->
                <ScrollViewer x:Name="GameContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Padding="24,12,24,32">
                    <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- ゲームフォルダ -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE838;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GameFolderSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="GameFolderSectionDesc"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run x:Name="SelectedFolderCountText" Text="0"/>
                                        <Run x:Name="SelectedFolderCountLabel"/>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="BulkChangeLabel" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="BulkPlatformSelector" MinWidth="140"
                                                  SelectionChanged="BulkPlatformSelector_Changed">
                                            <ComboBoxItem x:Name="PlatformSelectPlaceholder" Tag="" IsSelected="True"/>
                                            <ComboBoxItem Content="Steam" Tag="Steam"/>
                                            <ComboBoxItem Content="Epic Games" Tag="Epic"/>
                                            <ComboBoxItem Content="Microsoft Store" Tag="MSStore"/>
                                            <ComboBoxItem Content="itch.io" Tag="Itch"/>
                                            <ComboBoxItem x:Name="ManualPlatformItem" Tag="Manual"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <ListView x:Name="VanillaPathListView" ItemsSource="{x:Bind VanillaPaths}"
                                          SelectionMode="Multiple" BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6"
                                          SelectionChanged="VanillaPathListView_SelectionChanged"
                                          Margin="0,4,0,0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource CustomListViewItemStyle}"/>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:VanillaPathInfo">
                                            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto"
                                                  Padding="8" ColumnSpacing="10" VerticalAlignment="Center">
                                                <ComboBox Grid.Column="0" MinWidth="130"
                                                          SelectedValue="{x:Bind Platform, Mode=TwoWay}"
                                                          SelectedValuePath="Tag"
                                                          SelectionChanged="PlatformComboBox_SelectionChanged"
                                                          VerticalAlignment="Center">
                                                    <ComboBoxItem Content="---"     Tag=""/>
                                                    <ComboBoxItem Content="Steam"        Tag="Steam"/>
                                                    <ComboBoxItem Content="Epic Games"   Tag="Epic"/>
                                                    <ComboBoxItem Content="MS Store"     Tag="MSStore"/>
                                                    <ComboBoxItem Content="itch.io"      Tag="Itch"/>
                                                    <ComboBoxItem Content="手動"          Tag="Manual"/>
                                                </ComboBox>
                                                <TextBox Grid.Column="1"
                                                         Text="{x:Bind Name, Mode=TwoWay}"
                                                         Width="130" VerticalAlignment="Center"
                                                         PlaceholderText="{Binding [Settings_NamePlaceholder], Source={StaticResource Strings}}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CurrentVersion}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" Padding="4,0"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind Path}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                <Button Grid.Column="4"
                                                        Content="{Binding [Settings_Delete], Source={StaticResource Strings}}"
                                                        Click="RemovePath_Click" VerticalAlignment="Center"
                                                        Padding="8,4"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Expander x:Name="AutoDetectExpander" Padding="0,8">
                                    <StackPanel Spacing="10" Padding="0,8,0,4">
                                        <TextBlock x:Name="AutoDetectDesc" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid ColumnDefinitions="*, Auto" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBox x:Name="ScanTargetTextBox" IsReadOnly="True" VerticalAlignment="Center"/>
                                            <Button x:Name="SelectScanTargetBtn" Grid.Column="1"
                                                    Click="SelectScanTarget_Click" Margin="8,0,0,0"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="StartScanBtn" Click="ScanDrives_Click"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button x:Name="ClearPathBtn" Click="ClearScanTarget_Click"/>
                                            <Button x:Name="AddAllButton" Click="AddAllDetected_Click" IsEnabled="False"/>
                                        </StackPanel>
                                        <ListView x:Name="DetectedPathListView" ItemsSource="{x:Bind DetectedPaths}"
                                                  MaxHeight="160" BorderThickness="1"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="*, Auto" Padding="8">
                                                        <TextBlock Text="{x:Bind}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1"
                                                                Content="{Binding [Settings_Add], Source={StaticResource Strings}}"
                                                                Click="AddDetectedSingle_Click" Tag="{x:Bind}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- メインプラットフォーム -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MainPlatformSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="MainPlatformSectionDesc"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="MainPlatformIcon" Glyph="&#xE7FC;" FontSize="20"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="CurrentMainPlatformLabel"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="MainPlatformLabel" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="PlatformSwitchPanel" Spacing="8"/>
                                <TextBlock x:Name="PlatformSwitchHint"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Modインストール先 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModFolderSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ModFolderSectionDesc"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*, Auto" MaxWidth="560" HorizontalAlignment="Left">
                                    <TextBox x:Name="ModDataPathTextBox" IsReadOnly="True" VerticalAlignment="Center"/>
                                    <Button x:Name="ChangeModPathBtn" Click="ChangeModPath_Click"
                                            Grid.Column="1" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════
                     システムタブ (index 2)
                     ══════════════════════════════════════════ -->
                <ScrollViewer x:Name="SystemContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Padding="24,12,24,32">
                    <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- 起動・常駐 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LaunchSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="StartWithWindowsToggle" Toggled="StartWithWindowsToggle_Toggled"/>
                                <ToggleSwitch x:Name="StartMinimizedToggle" Toggled="StartMinimizedToggle_Toggled"/>
                                <ToggleSwitch x:Name="MinimizeToTrayToggle" Toggled="MinimizeToTrayToggle_Toggled"/>
                                <TextBlock x:Name="TrayHintText"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <ToggleSwitch x:Name="AlwaysRunAsAdminToggle" Toggled="AlwaysRunAsAdminToggle_Toggled"/>
                                <TextBlock x:Name="AlwaysAdminHintText"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Epic Games -->
                        <Border x:Name="EpicSettingsSection"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE83B;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="EpicSectionTitle" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CurrentPlatformText" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="EpicStatusIcon" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="EpicStatusText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="EpicOpenLauncherBtn" Click="EpicOpenLauncher_Click" Padding="12,6"/>
                                            <Button x:Name="EpicRecheckBtn" Click="EpicRecheck_Click" Padding="12,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ToggleSwitch x:Name="EpicLaunchViaLauncherToggle" Toggled="EpicLaunchViaLauncherToggle_Toggled"/>
                                <TextBlock x:Name="EpicLauncherDesc" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- ログ -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LogSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="LogSectionDesc" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="LogModeLabel" FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Spacing="8">
                                    <RadioButton x:Name="LogOverwriteRadio" GroupName="LogMode" Checked="LogMode_Checked"/>
                                    <RadioButton x:Name="LogNewFileRadio"   GroupName="LogMode" Checked="LogMode_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════
                     通知タブ (index 3)
                     ══════════════════════════════════════════ -->
                <ScrollViewer x:Name="NotifContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Padding="24,12,24,32">
                    <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7E7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NotifSectionTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="NotifSectionDesc"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <ToggleSwitch x:Name="NotifyModUpdateToggle" Toggled="NotifyToggle_Toggled"/>
                                <ToggleSwitch x:Name="NotifyAppUpdateToggle" Toggled="NotifyToggle_Toggled"/>
                                <ToggleSwitch x:Name="NotifyNewsToggle"      Toggled="NotifyToggle_Toggled"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- 保存バー (変更あり時のみ表示) -->
        <Border Grid.Row="3"
                x:Name="SaveBar"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusMessage"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,8"/>
            </Grid>
        </Border>
    </Grid>
</Page>
