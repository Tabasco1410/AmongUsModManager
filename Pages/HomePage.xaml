<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AmongUsModManager.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AmongUsModManager.Pages"
    xmlns:models="using:AmongUsModManager.Models"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <models:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="28,20,28,32">

                
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="20">
                    <TextBlock x:Name="HomePageTitle" Text="ホーム" FontSize="26" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <InfoBar x:Name="EmergencyBar"
                             Grid.Column="1"
                             IsOpen="False" IsClosable="True"
                             Severity="Error"
                             VerticalAlignment="Center"/>
                </Grid>

                
                <InfoBar x:Name="RateLimitBar"
                         IsOpen="False" IsClosable="True"
                         Severity="Warning">
                    <InfoBar.Content>
                        <StackPanel Spacing="6" Margin="0,4,0,4">
                            <TextBlock x:Name="RateLimitDesc1" TextWrapping="Wrap" FontSize="13"/>
                            <TextBlock x:Name="RateLimitDesc2" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                
                <InfoBar x:Name="LocalInfoBar"
                         IsOpen="False" IsClosable="True"
                         Severity="Informational"
                         CloseButtonClick="LocalInfoBar_CloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button x:Name="LocalInfoBarButton" Click="LocalInfoBarButton_Click"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchSectionTitle"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="ModSelector" Width="300"/>
                                <Button x:Name="OpenFolderBtn"
                                        Click="OpenFolderButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="LaunchBtn"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="160" Height="48"
                                VerticalAlignment="Center"
                                Click="LaunchButton_Click"/>
                    </Grid>
                </Border>

                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                    <StackPanel Spacing="12">

                        
                        <RelativePanel>
                            <StackPanel x:Name="ReleaseHeaderPanel" Spacing="2">
                                <TextBlock x:Name="ReleaseSectionTitle"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ReleaseLastUpdatedText"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="ReleaseCacheStatusText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        RelativePanel.AlignRightWithPanel="True"
                                        RelativePanel.AlignVerticalCenterWithPanel="True">
                                <ProgressRing x:Name="UpdateLoadingRing"
                                              IsActive="True" Width="18" Height="18"
                                              VerticalAlignment="Center"/>
                                <Button x:Name="ReleaseInfoRefreshBtn"
                                        Click="ReleaseInfoForceRefresh_Click"/>
                            </StackPanel>
                        </RelativePanel>

                        
                        <ListView x:Name="ReleaseListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ReleaseItem_Click">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ReleaseItem">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12" Padding="12,10"
                                          Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                          CornerRadius="6">

                                        
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind StatusColor}"/>

                                        
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind ModName}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <Border Background="{x:Bind BadgeColor}"
                                                        CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind BadgeText}"
                                                               FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind LatestTag}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind PublishedAt}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind CurrentVersion}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{Binding [Home_Update], Source={StaticResource Strings}}"
                                                    Visibility="{x:Bind CanUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="QuickUpdate_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="12,6"/>
                                            <Button Content="{Binding [Home_Install], Source={StaticResource Strings}}"
                                                    Visibility="{x:Bind CanInstall, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="QuickInstall_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="12,6"/>
                                            <Button Content="{Binding [Home_Detail], Source={StaticResource Strings}}"
                                                    Click="ReleaseDetail_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="12,6"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        
                        <TextBlock x:Name="ReleaseEmptyText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Margin="0,12" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                    <StackPanel Spacing="12">
                        <RelativePanel>
                            <StackPanel x:Name="AllReleaseHeaderPanel" Spacing="2">
                                <TextBlock x:Name="AllReleaseSectionTitle"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="AllReleaseLastUpdatedText"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="AllReleaseCacheStatusText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        RelativePanel.AlignRightWithPanel="True"
                                        RelativePanel.AlignVerticalCenterWithPanel="True">
                                <ProgressRing x:Name="AllReleaseLoadingRing"
                                              IsActive="False" Width="18" Height="18"/>
                                
                                <Button x:Name="AllReleaseRefreshBtn"
                                        Click="AllReleaseForceRefresh_Click"/>
                            </StackPanel>
                        </RelativePanel>

                        
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                            <ComboBox x:Name="AllReleaseModFilter"
                                      Width="180"
                                      SelectionChanged="AllReleaseFilter_Changed"/>
                            <ComboBox x:Name="AllReleaseSortFilter"
                                      Width="150"
                                      SelectionChanged="AllReleaseFilter_Changed"/>
                            <ToggleButton x:Name="AllReleaseLatestOnly"
                                          Checked="AllReleaseFilter_Changed"
                                          Unchecked="AllReleaseFilter_Changed"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="AllReleasePeriodFilter"
                                      Width="160"
                                      SelectionChanged="AllReleaseFilter_Changed"/>
                            <TextBlock x:Name="PageSizeLabel" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox x:Name="AllReleasePageSizeFilter"
                                      Width="90"
                                      SelectionChanged="AllReleaseFilter_Changed"/>
                            <TextBlock x:Name="AllReleaseTotalText"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        
                        <ListView x:Name="AllReleaseListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="AllReleaseItem_Click"
                                  MaxHeight="480">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AllReleaseItem">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12" Padding="12,10"
                                          CornerRadius="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind StatusColor}"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind ModName}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <Border Background="{x:Bind TypeColor}"
                                                        CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ModType}"
                                                               FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind TagName}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{x:Bind PublishedAt}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind GitHubRepo}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="3"
                                                Content="{Binding [Home_Detail], Source={StaticResource Strings}}"
                                                Tag="{x:Bind}"
                                                Click="AllReleaseDetail_Click"
                                                Padding="10,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="AllReleaseEmptyText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Margin="0,8"/>
                    </StackPanel>
                </Border>

                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                    <StackPanel Spacing="12">

                        
                        <RelativePanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="HomeNewsSectionTitle"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HomeNewsSubtitle"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        RelativePanel.AlignRightWithPanel="True"
                                        RelativePanel.AlignVerticalCenterWithPanel="True">
                                <ProgressRing x:Name="NewsLoadingRing"
                                              IsActive="False" Width="16" Height="16"
                                              VerticalAlignment="Center"/>
                                <Button x:Name="MarkAllReadBtn"
                                        Click="MarkAllRead_Click"/>
                            </StackPanel>
                        </RelativePanel>

                        
                        <ListView x:Name="NewsListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="NewsItem_Click">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:NewsDisplayItem">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                          ColumnSpacing="12" Padding="12,10"
                                          CornerRadius="6">
                                        
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind UnreadDotColor}"/>
                                        
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       Opacity="{x:Bind TitleOpacity}"/>
                                            <TextBlock Text="{x:Bind Content}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="{x:Bind ContentOpacity}"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Date}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="3"
                                                Content="{Binding [Home_MarkRead], Source={StaticResource Strings}}"
                                                FontSize="12"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Click="MarkReadBtn_Click"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind UnreadButtonVisibility}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NewsEmptyText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Margin="0,8" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="QuickInstallTitle"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="QuickInstallSubtitle"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="QuickInstallFromFile_Click" Width="180" Height="72">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="22"/>
                                    <TextBlock x:Name="FromFileText" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Click="QuickInstallFromCode_Click" Width="180" Height="72">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE716;" FontSize="22"/>
                                    <TextBlock x:Name="FromCodeText" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="LastMethodBtn"
                                    Click="QuickInstallLastMethod_Click"
                                    Width="180" Height="72">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE81C;" FontSize="22"/>
                                    <TextBlock x:Name="LastMethodText" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        
        <ContentDialog x:Name="UpdateProgressDialog">
            <StackPanel Spacing="10" Margin="0,10,0,0" Width="300">
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"/>
                <ProgressBar x:Name="UpdateProgressBar" IsIndeterminate="True"/>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ReleaseDetailDialog">
            <ScrollViewer MaxHeight="400">
                <StackPanel Spacing="12" Width="420">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DetailModName"
                                   FontSize="18" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DetailTag"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DetailDate"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <MenuFlyoutSeparator/>
                    
                    <WebView2 x:Name="DetailBodyWebView"
                              Height="280"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        
        <ContentDialog x:Name="ShareCodeDialog">
            <StackPanel Spacing="12" Width="340">
                <TextBlock x:Name="ShareCodeDesc"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="ShareCodeBox" FontFamily="Consolas"/>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="AppUpdateDialog">
            <StackPanel Spacing="12" Width="340">
                <TextBlock x:Name="AppUpdateBody" TextWrapping="Wrap" FontSize="13"/>
                <InfoBar x:Name="AppUpdateChangelogBar" IsOpen="True" IsClosable="False" Severity="Informational"/>
            </StackPanel>
        </ContentDialog>

    </Grid>
</Page>
